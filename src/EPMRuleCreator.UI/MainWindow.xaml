<Window x:Class="EPMRuleCreator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EPMRuleCreator" Icon="Assets/epm-rule-creator.ico" Height="900" Width="1180" MinHeight="720" MinWidth="980"
        Background="{DynamicResource CanvasBrush}" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen" Activated="Window_Activated">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="AppHeader" Grid.Row="0" Margin="0,0,0,20" Padding="18,14"
                CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource HeaderBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="HeaderLogo" Source="Assets/epm-rule-creator.png" Width="40" Height="40" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="EPMRuleCreator" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="UpdatesButton" Content="{Binding UpdatesButtonText}" Padding="10,6" FontSize="12" Margin="0"
                              Style="{StaticResource HeaderMenuButtonStyle}" AutomationProperties.Name="Updates and startup check settings"
                              IsChecked="{Binding IsUpdatesMenuOpen, Mode=TwoWay}" ToolTip="Updates and settings"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ToggleButton x:Name="ThemeSwitch" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" Width="44" Height="26"
                                  Cursor="Hand" ToolTip="{Binding ThemeToggleToolTip}" AutomationProperties.Name="Dark theme">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="SwitchTrack" CornerRadius="13" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Ellipse x:Name="SwitchThumb" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Margin="3,0" Fill="{DynamicResource MutedBrush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource OnPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="SwitchTrack" Property="BorderThickness" Value="2"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="Dark" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Content="{Binding ExplorerMenuButtonText, Mode=OneWay}" Command="{Binding ToggleExplorerMenuCommand}"
                        FontSize="12" Padding="10,6" Margin="12,0,0,0"
                        Visibility="{Binding IsInstalledApplication, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.ToolTip><ToolTip><TextBlock Text="{Binding ExplorerMenuToolTip}" TextWrapping="Wrap" MaxWidth="400"/></ToolTip></Button.ToolTip>
                </Button>
                <Button Content="&#x21BB;" Command="{Binding RepairExplorerMenuCommand}" Padding="8,3" FontSize="18" Margin="4,0,0,0"
                        Visibility="{Binding HasExplorerMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Repair or update Explorer context menu">
                    <Button.ToolTip><ToolTip><TextBlock Text="{Binding ExplorerMenuRepairToolTip}" TextWrapping="Wrap" MaxWidth="400"/></ToolTip></Button.ToolTip>
                </Button>
            </StackPanel>
            <ToggleButton x:Name="AccountButton" Grid.Column="2" Width="44" Height="44" Margin="20,0,0,0"
                          VerticalAlignment="Center" Cursor="Hand"
                          Content="{Binding AccountInitials, Mode=OneWay}"
                          IsChecked="{Binding IsAccountMenuOpen, Mode=TwoWay}"
                          ToolTip="{Binding AccountButtonLabel, Mode=OneWay}"
                          AutomationProperties.Name="{Binding AccountButtonLabel, Mode=OneWay}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="Avatar" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="2" CornerRadius="22">
                                            <Grid>
                                                <TextBlock x:Name="AccountPlaceholder" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                           Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <ContentPresenter x:Name="AccountInitialsPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <Ellipse x:Name="ConnectedIndicator" Width="11" Height="11" Fill="#168350" Stroke="{DynamicResource CanvasBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Avatar" Property="Opacity" Value="0.8"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                        <DataTrigger Binding="{Binding GraphConnected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                            <Setter TargetName="AccountPlaceholder" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="AccountInitialsPresenter" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ConnectedIndicator" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <Popup PlacementTarget="{Binding ElementName=UpdatesButton}" Placement="Bottom" VerticalOffset="8"
                   Width="320" AllowsTransparency="True" StaysOpen="False"
                   DataContext="{Binding DataContext, ElementName=UpdatesButton}" IsOpen="{Binding IsUpdatesMenuOpen, Mode=TwoWay}">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="4">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.14"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentVersionLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding ApplicationModeLabel}" ToolTip="{Binding ApplicationLocation}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                        <Button Content="{Binding InstallApplicationLabel}" Command="{Binding InstallApplicationCommand}"
                                ToolTip="Open installed app. Unsaved rule edits will be lost."
                                Visibility="{Binding IsPortableApplication, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <CheckBox Content="Check for updates at startup" IsChecked="{Binding CheckForUpdatesAtStartup, Mode=TwoWay}"
                                  ToolTip="Check GitHub releases at startup."/>
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,12,0,8"/>
                        <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}"/>
                        <Button Content="Update" Command="{Binding UpdateNowCommand}"
                                Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"
                                ToolTip="Install update and restart. Unsaved rule edits will be lost."
                                Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Open release page" Command="{Binding OpenReleaseCommand}"
                                Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Popup>
            <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountButton}" Placement="Bottom"
                   HorizontalOffset="-356" VerticalOffset="8" Width="400" AllowsTransparency="True" StaysOpen="False"
                   DataContext="{Binding DataContext, ElementName=AccountButton}"
                   IsOpen="{Binding IsAccountMenuOpen, Mode=TwoWay}" Opened="AccountPopup_Opened"
                   PreviewKeyDown="AccountPopup_PreviewKeyDown">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="4">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.14"/></Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Microsoft Entra" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                       ToolTip="Optional. File analysis works offline."/>
                            <Button x:Name="CloseAccountButton" Grid.Column="1" Content="&#x2715;" Click="CloseAccount_Click"
                                    ToolTip="Close account panel" AutomationProperties.Name="Close account panel"
                                    Padding="8,3" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"/>
                        </Grid>
                        <TextBlock Text="{Binding GraphAccount}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding GraphConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="Application (client) ID" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="ClientIdInput" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Client ID from your Entra app registration."/>
                        <TextBlock Text="Tenant ID" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional. Leave blank for any organizational tenant."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Sign in" Command="{Binding ConnectGraphCommand}" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"/>
                            <Button Content="Sign out" Command="{Binding DisconnectGraphCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GraphConnectionLabel}" Style="{StaticResource StatusText}">
                            <TextBlock.ToolTip><ToolTip><TextBlock Text="Connection details are in Logs."/></ToolTip></TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid x:Name="FilePickerGrid">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Selected file" FontWeight="SemiBold" Grid.ColumnSpan="3" Margin="0,0,0,8"/>
                <TextBox x:Name="SelectedFileInput" Grid.Row="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True" Margin="0" Height="40" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                <Button x:Name="ChooseFileButton" Grid.Row="1" Grid.Column="1" Content="Choose file" Click="ChooseFile_Click"
                        IsEnabled="{Binding CanChooseFile, Mode=OneWay}" Height="40" Margin="12,0,8,0" VerticalAlignment="Center"/>
                <Button x:Name="AnalyzeFileButton" Grid.Row="1" Grid.Column="2" Content="Analyze file" Command="{Binding AnalyzeCommand}"
                        Height="40" Margin="0" VerticalAlignment="Center" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"/>
                <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="Use EpmCmdlets" IsChecked="{Binding UseEpmCmdlets, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseEpmCmdlets}" ToolTip="{Binding EpmCmdletsToolTip}"
                          ToolTipService.ShowOnDisabled="True" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="File information" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="SHA256" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBox Text="{Binding Sha256}" IsReadOnly="True" FontFamily="Consolas"/>
                            <StackPanel Visibility="{Binding HasEpmFileHash, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="EPM Tools hash" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding EpmFileHash}" IsReadOnly="True" FontFamily="Consolas"/>
                            </StackPanel>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Product name" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding ProductName}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Margin="10,0,0,0"><TextBlock Text="Version" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding Version}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Company" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding CompanyName}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Signature" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBox Text="{Binding SignatureStatus}" IsReadOnly="True">
                                        <TextBox.ToolTip><ToolTip><StackPanel MaxWidth="440">
                                            <TextBlock Text="{Binding SignatureDetails}" TextWrapping="Wrap"/>
                                        </StackPanel></ToolTip></TextBox.ToolTip>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Internal name" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding InternalName}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Margin="10,0,0,0"><TextBlock Text="File description" Foreground="{DynamicResource MutedBrush}" ToolTip="From file metadata."/><TextBox Text="{Binding FileDescription}" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="&#x2139; Analysis notes" FontSize="12" Foreground="{DynamicResource WarningBrush}" Cursor="Help"
                                       Visibility="{Binding HasAnalysisWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock.ToolTip><ToolTip><TextBlock Text="See Logs for analysis warnings."/></ToolTip></TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                            Visibility="{Binding HasAnalyzedPublisherCertificate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Signing certificate" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding CertificateChainEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,4">
                                            <Border.ToolTip><ToolTip><TextBlock Text="{Binding Details}" TextWrapping="Wrap" MaxWidth="440"/></ToolTip></Border.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Role}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Text="{Binding Certificate.Subject}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Validity}" FontSize="12" Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Certificate.IsWithinValidityPeriod}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding CertificateChainLabel}" FontSize="12" Margin="0,6,0,0">
                                <TextBlock.ToolTip><ToolTip><TextBlock Text="{Binding CertificateChainDetails}" TextWrapping="Wrap" MaxWidth="440"/></ToolTip></TextBlock.ToolTip>
                            </TextBlock>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Export certificates…" Click="ExportIndividualCertificates_Click" IsEnabled="{Binding CanExportCertificateChain}"
                                        ToolTip="Export one CER per public certificate. No private keys."/>
                                <Button Content="Export chain bundle…" Click="ExportCertificateChain_Click" IsEnabled="{Binding CanExportCertificateChain}"
                                        ToolTip="Export public certificates as P7B or PEM."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="Clear" Command="{Binding ClearLogCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="8,3" FontSize="12"/>
                                <TextBlock Text="Logs" FontSize="18" FontWeight="SemiBold"/>
                            </DockPanel>
                            <TextBox Text="{Binding ActivityLogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     Height="230" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                     TextChanged="ActivityLog_TextChanged" ToolTip="Session log. Select text to copy."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Elevation rule" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Elevation Rules policy" Foreground="{DynamicResource MutedBrush}"/>
                            <ComboBox ItemsSource="{Binding ElevationPolicyOptions}" SelectedItem="{Binding SelectedPolicyOption}"
                                      IsEnabled="{Binding CanSelectElevationPolicy, Mode=OneWay}" DropDownOpened="ElevationPolicies_DropDownOpened">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNewPolicy}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Visibility="{Binding IsCreatingPolicy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="New policy name *" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding NewPolicyName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Policy description" Foreground="{DynamicResource MutedBrush}" ToolTip="Optional. Scope tag: 0; no assignments."/>
                                <TextBox Text="{Binding NewPolicyDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedPolicySummary}" Style="{StaticResource StatusText}" Margin="0,0,0,12"/>
                            <TextBlock Text="Rule name" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Rule description" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="68" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FileNameLabel}" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleFileName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Minimum version" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleFileVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" ToolTip="Optional. Four numbers, e.g. 1.1.0.0."/>
                            <TextBlock Text="{Binding FileHashLabel}" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleFileHash, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                            <TextBlock Text="File description" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleFileDescription, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="File path" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Product name" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleProductName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Internal name" Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding RuleInternalName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Signature source" Foreground="{DynamicResource MutedBrush}"/><ComboBox ItemsSource="{Binding SignatureSourceOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SignatureSource}"/>
                            <StackPanel Visibility="{Binding ShowCertificateSelection, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                                <StackPanel Visibility="{Binding ShowCertificateFileSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Certificate" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                    <RadioButton Content="Use analyzed file certificate" GroupName="CertificateFileSource"
                                                 IsChecked="{Binding UseAnalyzedCertificate, Mode=TwoWay}"
                                                 IsEnabled="{Binding HasAnalyzedPublisherCertificate}" Margin="0,4,0,4">
                                        <RadioButton.ToolTip><ToolTip><TextBlock Text="{Binding AnalyzedCertificateDetails}" TextWrapping="Wrap" MaxWidth="440"/></ToolTip></RadioButton.ToolTip>
                                    </RadioButton>
                                    <RadioButton Content="{Binding UploadedCertificateLabel}" GroupName="CertificateFileSource"
                                                 IsChecked="{Binding UseUploadedCertificate, Mode=TwoWay}"
                                                 Visibility="{Binding HasUploadedCertificate, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 ToolTip="{Binding SelectedCertificateFile}" Margin="0,4,0,4"/>
                                    <Button Content="Choose certificate file…" Click="ChooseCertificateFile_Click" HorizontalAlignment="Left" Margin="0,6,0,4"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowReusableCertificateSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Certificate" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                    <ComboBox ItemsSource="{Binding ReusableCertificateSettings}" SelectedItem="{Binding SelectedReusableCertificateSetting}"
                                              DisplayMemberPath="DisplayName" IsEnabled="{Binding GraphConnected}"
                                              DropDownOpened="ReusableCertificates_DropDownOpened"/>
                                    <TextBlock Text="{Binding ReusableCertificateStatusLabel}" Style="{StaticResource StatusText}">
                                        <TextBlock.ToolTip><ToolTip><TextBlock Text="{Binding ReusableCertificateSelectionHint}" TextWrapping="Wrap" MaxWidth="440"/></ToolTip></TextBlock.ToolTip>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="Certificate type" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
                                <ComboBox ItemsSource="{Binding CertificateTypeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding CertificateType}"/>
                            </StackPanel>
                            <TextBlock Text="Elevation type" Foreground="{DynamicResource MutedBrush}"/><ComboBox ItemsSource="{Binding ElevationTypes}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ElevationType}"/>
                            <StackPanel Margin="0,4,0,8" Visibility="{Binding IsUserConfirmed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="User confirmation validation" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                <CheckBox Content="Business justification" IsChecked="{Binding RequireBusinessJustification}" Margin="0,3"/>
                                <CheckBox Content="Windows authentication" IsChecked="{Binding RequireWindowsAuthentication}" Margin="0,3"/>
                            </StackPanel>
                            <StackPanel Margin="0,4,0,8" Visibility="{Binding IsCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Validation" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                <CheckBox Content="Windows authentication *" IsChecked="{Binding IsCurrentUser, Mode=OneWay}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Required when elevating as the current user." Margin="0,3"/>
                                <TextBlock Text="Additional validation requirement" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                <CheckBox Content="Business justification" IsChecked="{Binding RequireBusinessJustification}" Margin="0,3"/>
                            </StackPanel>
                            <TextBlock Text="Child process behavior" Foreground="{DynamicResource MutedBrush}"/><ComboBox ItemsSource="{Binding ChildProcessBehaviors}" SelectedItem="{Binding ChildProcessBehavior}"/>
                            <TextBlock Text="Restrict Arguments" Foreground="{DynamicResource MutedBrush}"/><ComboBox ItemsSource="{Binding RestrictArgumentsOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding RestrictArguments}"/>
                            <StackPanel Visibility="{Binding ShowArgumentList, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Argument List" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBox Text="{Binding ArgumentListText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" ToolTip="One argument per line."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Validation" FontSize="18" FontWeight="SemiBold"/>
                            <Button Content="Validate rule" Command="{Binding ValidateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            <Button Content="{Binding UploadButtonText, Mode=OneWay}" Command="{Binding UploadRuleCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" ToolTip="Writes immediately. New policies have no assignments. See Logs."/>
                            <ItemsControl ItemsSource="{Binding BlockingValidationMessages}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ValidationWarningsLabel}" Style="{StaticResource StatusText}" Foreground="{DynamicResource WarningBrush}" Cursor="Help">
                                <TextBlock.ToolTip><ToolTip><TextBlock Text="See Logs for validation warnings."/></ToolTip></TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="AuthorFooter" Grid.Row="3" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Right" TextWrapping="Wrap" Margin="0,12,0,0">
            <Run Text="Built by Mathias Borowicz"/>
            <Run Text=" · "/>
            <Hyperlink NavigateUri="https://github.com/mathiasborowicz/EPMRuleCreator" RequestNavigate="AuthorLink_RequestNavigate"
                       Foreground="{DynamicResource AccentBrush}">Repository</Hyperlink>
            <Run Text=" · "/>
            <Hyperlink NavigateUri="https://zerotruststories.com/" RequestNavigate="AuthorLink_RequestNavigate"
                       Foreground="{DynamicResource AccentBrush}">Blog</Hyperlink>
        </TextBlock>

    </Grid>
</Window>
