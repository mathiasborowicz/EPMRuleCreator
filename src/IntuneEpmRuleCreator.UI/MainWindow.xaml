<Window x:Class="IntuneEpmRuleCreator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intune EPM Rule Creator" Height="900" Width="1180" MinHeight="720" MinWidth="980"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Intune EPM Rule Creator" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Build a file-based elevation rule from verified file metadata." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#FFF3D9" CornerRadius="7" Padding="12,8" VerticalAlignment="Center">
                <TextBlock Text="Intune writes require explicit confirmation" Foreground="#754C00" FontSize="12"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Selected file" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button Content="Choose file" Click="ChooseFile_Click"/>
                    <Button Content="Analyze file" Command="{Binding AnalyzeCommand}" Background="{StaticResource AccentBrush}" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="File information" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="SHA256" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Text="{Binding Sha256}" IsReadOnly="True" FontFamily="Consolas"/>
                            <TextBlock Text="EPM Tools hash" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding EpmFileHash}" IsReadOnly="True" FontFamily="Consolas"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Product name" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding ProductName}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Margin="10,0,0,0"><TextBlock Text="Version" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding Version}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Company" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding CompanyName}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Margin="10,0,0,0"><TextBlock Text="Signature" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding SignatureStatus}" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Internal name" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding InternalName}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Margin="10,0,0,0"><TextBlock Text="Description" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding FileDescription}" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding CertificateSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding AnalysisWarnings}" Foreground="#8A4B00" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Optional Microsoft Graph connection" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Local file analysis works without sign-in, network access, or a tenant. Connect only when you want to load EPM policies." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,10"/>
                            <TextBlock Text="Application (client) ID" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Tenant ID or 'organizations'" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <Button Content="Sign in / switch account" Command="{Binding ConnectGraphCommand}"/>
                                <Button Content="Sign out" Command="{Binding DisconnectGraphCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GraphConnectionStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding GraphAccount}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                            <Separator Margin="0,12,0,10"/>
                            <TextBlock Text="Elevation Rules policy" FontSize="16" FontWeight="SemiBold"/>
                            <Button Content="Load policies" Command="{Binding LoadPoliciesCommand}" HorizontalAlignment="Left" Margin="0,8,0,6"/>
                            <ComboBox ItemsSource="{Binding ElevationPolicies}" SelectedItem="{Binding SelectedElevationPolicy}" DisplayMemberPath="Name"/>
                            <Button Content="Read rule count" Command="{Binding LoadSelectedPolicyCountCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding PolicyLoadStatus}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding SelectedPolicySummary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Separator Margin="0,12,0,10"/>
                            <TextBlock Text="Reusable EPM certificate settings" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Only reusable settings whose definition is the EPM certificate setting are shown; other Intune reusable settings are excluded." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                            <Button Content="Load reusable certificate settings" Command="{Binding LoadReusableCertificateSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,6"/>
                            <ComboBox ItemsSource="{Binding ReusableCertificateSettings}" DisplayMemberPath="DisplayName"/>
                            <TextBlock Text="The app counts groupSettingCollectionValue entries; policy settingCount is different. Upload appends a rule only after confirmation and requires an existing rule of the same identification/certificate source as a payload template." TextWrapping="Wrap" Foreground="#754C00" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Elevation rule" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Rule name" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Description" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RuleDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="68" TextWrapping="Wrap"/>
                            <TextBlock Text="File name" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RuleFileName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="File version (four numeric parts, e.g. 12.3.5.5)" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RuleFileVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                            <TextBlock Text="File hash (SHA256)" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RuleFileHash, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                            <TextBlock Text="File path" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RuleFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Product name" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RuleProductName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Internal name" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding RuleInternalName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Identification strategy" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding IdentificationStrategies}" SelectedItem="{Binding IdentificationStrategy}"/>
                            <StackPanel Visibility="{Binding ShowCertificateSelection, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                                <TextBlock Text="Certificate selection" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                <RadioButton Content="{Binding PublisherCertificateChoiceText}" IsChecked="{Binding UsePublisherCertificate}" IsEnabled="{Binding HasPublisherCertificate}" GroupName="CertificateSource" Margin="0,4"/>
                                <RadioButton Content="Use an EPM reusable certificate setting" IsChecked="{Binding UseReusableCertificate}" GroupName="CertificateSource" Margin="0,4"/>
                                <ComboBox ItemsSource="{Binding ReusableCertificateSettings}" SelectedItem="{Binding SelectedReusableCertificateSetting}" DisplayMemberPath="DisplayName" IsEnabled="{Binding UseReusableCertificate}"/>
                                <TextBlock Text="{Binding ReusableCertificateSelectionHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="{Binding UseReusableCertificate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBlock Text="Elevation type" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding ElevationTypes}" SelectedItem="{Binding ElevationType}"/>
                            <TextBlock Text="Child process behavior" Foreground="{StaticResource MutedBrush}"/><ComboBox ItemsSource="{Binding ChildProcessBehaviors}" SelectedItem="{Binding ChildProcessBehavior}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Validation" FontSize="18" FontWeight="SemiBold"/>
                            <Button Content="Validate rule" Command="{Binding ValidateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            <Button Content="Upload rule to selected Intune policy" Command="{Binding UploadRuleCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Background="{StaticResource AccentBrush}" Foreground="White"/>
                            <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <ItemsControl ItemsSource="{Binding ValidationMessages}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#8A3B12" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="No changes are automatic. The upload button appends only after a separate confirmation." Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
    </Grid>
</Window>
