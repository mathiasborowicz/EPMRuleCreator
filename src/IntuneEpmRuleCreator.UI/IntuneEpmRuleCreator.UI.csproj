<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>IntuneEpmRuleCreator</AssemblyName>
    <RootNamespace>IntuneEpmRuleCreator.UI</RootNamespace>
    <Version>0.1.0</Version>
    <GraphClientId Condition="'$(GraphClientId)' == ''"></GraphClientId>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GraphClientId" Value="$(GraphClientId)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IntuneEpmRuleCreator.Core/IntuneEpmRuleCreator.Core.csproj" />
    <ProjectReference Include="../IntuneEpmRuleCreator.Graph/IntuneEpmRuleCreator.Graph.csproj" />
  </ItemGroup>
</Project>
