<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>IntuneEpmRuleCreator</AssemblyName>
    <RootNamespace>IntuneEpmRuleCreator.UI</RootNamespace>
    <Version>0.9.0</Version>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Mathias Borowicz</Copyright>
    <ApplicationIcon>Assets/epm-rule-creator.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/epm-rule-creator.ico" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="IntuneEpmRuleCreator.LICENSE" />
    <ProjectReference Include="../IntuneEpmRuleCreator.Core/IntuneEpmRuleCreator.Core.csproj" />
    <ProjectReference Include="../IntuneEpmRuleCreator.Graph/IntuneEpmRuleCreator.Graph.csproj" />
  </ItemGroup>
</Project>
